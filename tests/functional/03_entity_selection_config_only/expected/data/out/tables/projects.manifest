        "base": {
          "type": "INTEGER"
        }
      },
      "nullable": true
    },
    {
      "name": "icon_url",
      "data_type": {
        "base": {
          "type": "STRING"
        }
      },
      "nullable": true
    },
    {
      "name": "icon_url_large",
      "data_type": {
        "base": {
